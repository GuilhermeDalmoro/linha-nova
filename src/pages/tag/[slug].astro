---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts,slugify,path,allTags } from '../../lib/posts';
export async function getStaticPaths(){const posts=await getPosts();return allTags(posts).map(tag=>({params:{slug:slugify(tag)},props:{tag,posts:posts.filter(p=>p.data.tags.includes(tag))}}));}
const {tag,posts}=Astro.props;
---
<BaseLayout title={`Textos sobre ${tag}`} description={`Uma seleção de textos da Linha Nova com a tag ${tag}.`}><div class="container page-shell"><nav class="breadcrumb" aria-label="Caminho da página"><a href={path('categorias/')}>Categorias e tags</a><span>/</span><span>{tag}</span></nav><header class="page-heading"><p class="eyebrow">LINHAS QUE SE ENCONTRAM</p><h1>#{tag}</h1><p>{posts.length} {posts.length===1?'texto para':'textos para'} continuar essa leitura.</p></header><div class="text-list">{posts.map(post=><PostCard post={post}/>)}</div></div></BaseLayout>
