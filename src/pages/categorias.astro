---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';
import Icon from '../components/Icon.astro';
import { categories,getPosts,path,allTags } from '../lib/posts';
const posts=await getPosts();
---
<BaseLayout title="Categorias" description="Encontre textos sobre política, história, religião, filosofia, cultura e tecnologia."><div class="container page-shell"><header class="page-heading"><p class="eyebrow">MUITAS PERGUNTAS, ALGUNS CAMINHOS</p><h1>Por onde começar?</h1><p>Escolha um assunto. Siga a linha que despertar sua curiosidade.</p></header><div class="category-grid">{categories.map(c=>{const count=posts.filter(p=>p.data.category===c.name).length;return <a class:list={['category-tile',c.color]} href={path(`categoria/${c.slug}/`)}><span class="tile-mark" aria-hidden="true"></span><h2>{c.name}</h2><p>{c.description}</p><div class="tile-bottom"><span>{count} {count===1?'texto':'textos'}</span><Icon name="arrow" size={18}/></div></a>})}</div>{allTags(posts).length>0&&<section class="tag-section"><h2>Outras linhas de leitura</h2><div class="tags">{allTags(posts).map(tag=><Tag name={tag}/>)}</div></section>}</div></BaseLayout>
