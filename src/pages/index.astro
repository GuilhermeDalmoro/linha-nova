---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import { getPosts, postPath, readingTime, shortDate, categories, path, imagePath } from '../lib/posts';
const posts = await getPosts();
const featured = posts.find(p => p.data.featured) || posts[0];
const recent = posts.filter(p => p.id !== featured?.id);
---
<BaseLayout>
  <div class="container home home-minimal">
    <section class="home-intro-minimal">
      <div><p class="eyebrow">UM CADERNO ABERTO</p><h1>Ideias que merecem<br/><em>mais de uma linha.</em></h1><p>Textos, ensaios e reflexões independentes de Guilherme Dalmoro.</p></div>
    </section>
    {featured && <section class="featured-minimal" aria-labelledby="featured-title">
      <div class="featured-minimal-copy"><div class="feature-top"><span class="eyebrow">PARA COMEÇAR</span><CategoryBadge name={featured.data.category}/></div>
        <h2 id="featured-title"><a href={postPath(featured)}>{featured.data.title}</a></h2><p class="feature-description">{featured.data.description}</p>
        <div class="feature-bottom"><div class="post-meta"><time datetime={featured.data.date.toISOString()}>{shortDate(featured.data.date)}</time><span aria-hidden="true">·</span><span>{readingTime(featured)} min de leitura</span></div><a class="text-link" href={postPath(featured)}>Ler texto <span aria-hidden="true">↗</span></a></div>
      </div>
      {featured.data.cover && <img class="feature-cover" src={imagePath(featured.data.cover)} alt={featured.data.coverAlt} width="1000" height="600" fetchpriority="high" decoding="async"/>}
    </section>}
    <section class="recent-section recent-minimal" aria-labelledby="recent-title"><div class="section-heading"><h2 id="recent-title">Textos recentes</h2><a href={path('textos/')} class="subtle-link">Todos os textos ↗</a></div>
      {recent.length ? recent.map(post => <PostCard post={post}/>) : <p class="empty-note">Os próximos textos começam aqui.</p>}
    </section>
    <nav class="home-topics" aria-label="Assuntos"><span>Assuntos</span>{categories.map(category => <a href={path('categoria/' + category.slug + '/')}>{category.name}</a>)}</nav>
    <section class="home-about"><p class="eyebrow">LINHA NOVA</p><p>Um espaço próprio para pensar, escrever e conversar sem pressa.</p><a href={path('sobre/')} class="text-link">Sobre o projeto ↗</a></section>
  </div>
</BaseLayout>
